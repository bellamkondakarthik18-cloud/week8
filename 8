// ===========================================================================
// 1. IMPLICIT ANIMATIONS
//    Just change a value inside setState; Flutter animates between the old
//    and new value. No controller needed.
// ===========================================================================
class ImplicitDemo extends StatefulWidget {
  const ImplicitDemo({super.key});

  @override
  State<ImplicitDemo> createState() => _ImplicitDemoState();
}

class _ImplicitDemoState extends State<ImplicitDemo> {
  bool _toggled = false;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          // AnimatedContainer: size, color, shape (the "Size" and "Scale" rows)
          AnimatedContainer(
            duration: const Duration(milliseconds: 600),
            curve: Curves.easeInOut,
            width: _toggled ? 200 : 100,
            height: _toggled ? 100 : 100,
            decoration: BoxDecoration(
              color: _toggled ? Colors.orange : Colors.blue,
              borderRadius: BorderRadius.circular(_toggled ? 50 : 8),
            ),
            alignment: Alignment.center,
            child: const Text('Container', style: TextStyle(color: Colors.white)),
          ),
          const SizedBox(height: 16),

          // AnimatedOpacity: fade
          AnimatedOpacity(
            duration: const Duration(milliseconds: 600),
            opacity: _toggled ? 0.2 : 1.0,
            child: const Chip(label: Text('AnimatedOpacity')),
          ),
          const SizedBox(height: 16),

          // AnimatedPositioned (must live inside a Stack): slide
          SizedBox(
            height: 70,
            child: Stack(
              children: [
                AnimatedPositioned(
                  duration: const Duration(milliseconds: 600),
                  curve: Curves.bounceOut,
                  left: _toggled ? 220 : 0,
                  top: 10,
                  child: const CircleAvatar(
                    radius: 24,
                    child: Icon(Icons.arrow_forward),
                  ),
                ),
              ],
            ),
          ),

          // AnimatedAlign: move within parent using alignment
          Container(
            height: 70,
            decoration: BoxDecoration(
              border: Border.all(color: Colors.grey),
              borderRadius: BorderRadius.circular(8),
            ),
            child: AnimatedAlign(
              duration: const Duration(milliseconds: 600),
              curve: Curves.easeOutBack,
              alignment: _toggled ? Alignment.centerRight : Alignment.centerLeft,
              child: const Padding(
                padding: EdgeInsets.all(8),
                child: FlutterLogo(size: 40),
              ),
            ),
          ),
          const SizedBox(height: 16),

          // AnimatedSwitcher: cross-fade between different widgets
          AnimatedSwitcher(
            duration: const Duration(milliseconds: 400),
            transitionBuilder: (child, anim) => ScaleTransition(scale: anim, child: child),
            child: Icon(
              _toggled ? Icons.favorite : Icons.favorite_border,
              key: ValueKey(_toggled),
              size: 48,
              color: Colors.red,
            ),
          ),
          const Spacer(),
          FilledButton(
            onPressed: () => setState(() => _toggled = !_toggled),
            child: const Text('Toggle'),
          ),
        ],
      ),
    );
  }
}

// ===========================================================================
// 2. EXPLICIT ANIMATIONS
//    AnimationController + Tween + *Transition widgets
// ===========================================================================

/// The basic workflow from the notes: fade in when the widget first appears.
class FadeInBox extends StatefulWidget {
  const FadeInBox({super.key});

  @override
  State<FadeInBox> createState() => _FadeInBoxState();
}

class _FadeInBoxState extends State<FadeInBox> with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _fadeAnimation;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      duration: const Duration(seconds: 1),
      vsync: this,
    );
    _fadeAnimation = Tween<double>(begin: 0.0, end: 1.0).animate(_controller);
    _controller.forward();
  }

  @override
  void dispose() {
    _controller.dispose(); // always dispose controllers
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return FadeTransition(
      opacity: _fadeAnimation,
      child: Container(
        padding: const EdgeInsets.all(16),
        color: Colors.deepPurple.shade100,
        child: const Text('I fade in when the screen opens'),
      ),
    );
  }
}

class ExplicitDemo extends StatefulWidget {
  const ExplicitDemo({super.key});

  @override
  State<ExplicitDemo> createState() => _ExplicitDemoState();
}

class _ExplicitDemoState extends State<ExplicitDemo> with SingleTickerProviderStateMixin {
  late final AnimationController _controller;
  late final Animation<double> _curved;
  late final Animation<double> _fade;
  late final Animation<Offset> _slide;
  late final Animation<double> _scale;
  late final Animation<double> _rotation;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      duration: const Duration(seconds: 2),
      vsync: this,
    );
    // CurvedAnimation applies an easing curve on top of the controller
    _curved = CurvedAnimation(parent: _controller, curve: Curves.easeInOut);

    // One controller can drive many Tweens
    _fade = Tween<double>(begin: 0.1, end: 1.0).animate(_curved);
    _slide = Tween<Offset>(begin: const Offset(-1, 0), end: Offset.zero).animate(_curved);
    _scale = Tween<double>(begin: 0.4, end: 1.0).animate(_curved);
    _rotation = Tween<double>(begin: 0.0, end: 1.0).animate(_curved); // in turns
  }

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  Widget _box(Color color, String label) => Container(
        width: 90,
        height: 90,
        alignment: Alignment.center,
        decoration: BoxDecoration(color: color, borderRadius: BorderRadius.circular(12)),
        child: Text(label, style: const TextStyle(color: Colors.white, fontSize: 12)),
      );

  Widget _labeled(String title, Widget child) => Column(
        children: [
          SizedBox(height: 100, width: 100, child: Center(child: child)),
          Text(title, style: Theme.of(context).textTheme.labelMedium),
        ],
      );

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          const FadeInBox(),
          const SizedBox(height: 24),
          Wrap(
            spacing: 16,
            runSpacing: 16,
            alignment: WrapAlignment.center,
            children: [
              _labeled('Fade', FadeTransition(opacity: _fade, child: _box(Colors.blue, 'Fade'))),
              _labeled(
                'Slide',
                ClipRect(
                  child: SlideTransition(position: _slide, child: _box(Colors.green, 'Slide')),
                ),
              ),
              _labeled('Scale', ScaleTransition(scale: _scale, child: _box(Colors.orange, 'Scale'))),
              _labeled(
                'Rotation',
                RotationTransition(turns: _rotation, child: _box(Colors.pink, 'Rotate')),
              ),
            ],
          ),
          const SizedBox(height: 24),

          // Show the controller's raw value (0.0 -> 1.0)
          AnimatedBuilder(
            animation: _controller,
            builder: (_, __) => Column(
              children: [
                LinearProgressIndicator(value: _controller.value),
                const SizedBox(height: 4),
                Text('value: ${_controller.value.toStringAsFixed(2)}  |  ${_controller.status.name}'),
              ],
            ),
          ),
          const SizedBox(height: 16),

          // Full control over direction
          Wrap(
            spacing: 8,
            children: [
              FilledButton(onPressed: _controller.forward, child: const Text('Forward')),
              FilledButton(onPressed: _controller.reverse, child: const Text('Reverse')),
              FilledButton(
                onPressed: () => _controller.repeat(reverse: true),
                child: const Text('Repeat'),
              ),
              OutlinedButton(onPressed: _controller.stop, child: const Text('Stop')),
              OutlinedButton(onPressed: _controller.reset, child: const Text('Reset')),
            ],
          ),
        ],
      ),
    );
  }
}

// ===========================================================================
// 3. ANIMATEDBUILDER: custom and staggered animations
// ===========================================================================
class BuilderDemo extends StatefulWidget {
  const BuilderDemo({super.key});

  @override
  State<BuilderDemo> createState() => _BuilderDemoState();
}

class _BuilderDemoState extends State<BuilderDemo> with TickerProviderStateMixin {
  // Two controllers -> TickerProviderStateMixin (not the "Single" version)
  late final AnimationController _pulse;
  late final AnimationController _stagger;

  late final Animation<double> _pulseScale;
  late final Animation<double> _fade;
  late final Animation<Offset> _slide;
  late final Animation<double> _size;
  late final Animation<Color?> _color;

  @override
  void initState() {
    super.initState();

    // Looping pulse
    _pulse = AnimationController(vsync: this, duration: const Duration(milliseconds: 800))
      ..repeat(reverse: true);
    _pulseScale = Tween<double>(begin: 0.9, end: 1.2)
        .animate(CurvedAnimation(parent: _pulse, curve: Curves.easeInOut));

    // Staggered: each animation uses a slice (Interval) of the same timeline
    _stagger = AnimationController(vsync: this, duration: const Duration(seconds: 3));

    _fade = Tween<double>(begin: 0, end: 1).animate(
      CurvedAnimation(parent: _stagger, curve: const Interval(0.0, 0.3, curve: Curves.easeIn)),
    );
    _slide = Tween<Offset>(begin: const Offset(-0.5, 0), end: Offset.zero).animate(
      CurvedAnimation(parent: _stagger, curve: const Interval(0.2, 0.6, curve: Curves.easeOut)),
    );
    _size = Tween<double>(begin: 80, end: 160).animate(
      CurvedAnimation(parent: _stagger, curve: const Interval(0.5, 0.8, curve: Curves.elasticOut)),
    );
    _color = ColorTween(begin: Colors.blue, end: Colors.deepOrange).animate(
      CurvedAnimation(parent: _stagger, curve: const Interval(0.7, 1.0)),
    );
  }

  @override
  void dispose() {
    _pulse.dispose();
    _stagger.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          Text('Pulse (repeat)', style: Theme.of(context).textTheme.titleMedium),
          const SizedBox(height: 16),
          // AnimatedBuilder rebuilds only this subtree each frame.
          // `child` is built once and reused (a performance optimisation).
          AnimatedBuilder(
            animation: _pulse,
            child: const Icon(Icons.favorite, color: Colors.red, size: 64),
            builder: (context, child) => Transform.scale(scale: _pulseScale.value, child: child),
          ),
          const Divider(height: 48),

          Text('Staggered (Interval)', style: Theme.of(context).textTheme.titleMedium),
          const SizedBox(height: 16),
          SizedBox(
            height: 180,
            child: AnimatedBuilder(
              animation: _stagger,
              builder: (context, _) => FadeTransition(
                opacity: _fade,
                child: SlideTransition(
                  position: _slide,
                  child: Container(
                    width: _size.value,
                    height: _size.value,
                    decoration: BoxDecoration(
                      color: _color.value,
                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: Transform.rotate(
                      angle: _stagger.value * 2 * math.pi,
                      child: const Icon(Icons.star, color: Colors.white),
                    ),
                  ),
                ),
              ),
            ),
          ),
          const Spacer(),
          Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              FilledButton(
                onPressed: () => _stagger.forward(from: 0),
                child: const Text('Play'),
              ),
              const SizedBox(width: 12),
              OutlinedButton(onPressed: _stagger.reverse, child: const Text('Reverse')),
            ],
          ),
        ],
      ),
    );
  }
}
